# =============================================================================
# PayEye Secure Infrastructure - .gitignore
# Goal: prevent accidental commit of state, secrets, and machine-local artifacts.
# Anything matching these patterns must NEVER reach the remote repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Terraform — state, cache, and lock metadata
# State files contain plaintext secrets (RDS passwords, ARNs, account IDs).
# They MUST live in the encrypted S3 backend, never in Git.
# -----------------------------------------------------------------------------
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Variable files often contain secrets (db passwords, API keys, account IDs).
# Commit only `*.example.tfvars` placeholders, never the real ones.
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# Override files are developer-local — do not share.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files can leak resource diffs and sensitive values.
*.tfplan
*.tfplan.*
plan.out
tfplan

# -----------------------------------------------------------------------------
# Kubernetes & Helm — rendered manifests and chart caches
# -----------------------------------------------------------------------------
**/charts/
**/Chart.lock
kubeconfig
kubeconfig-*
*.kubeconfig

# Rendered/templated manifests that may contain secrets
manifests-rendered/
**/*.rendered.yaml

# -----------------------------------------------------------------------------
# Secrets & credentials — never commit
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
id_rsa
id_ed25519
credentials
credentials.json
secrets.yaml
secrets.yml
sealed-secrets-key.*

# AWS / cloud credentials accidentally placed in repo
.aws/
aws-credentials
aws-credentials.txt

# -----------------------------------------------------------------------------
# IDE & editor artifacts
# -----------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# Operating system
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Language ecosystems (placeholders for future apps in monorepo)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Go
vendor/
*.test
*.out

# -----------------------------------------------------------------------------
# CI / scan artifacts
# -----------------------------------------------------------------------------
checkov-report.*
trivy-report.*
tfsec-report.*
*.sarif
.scannerwork/

# -----------------------------------------------------------------------------
# Local task / scratch files
# -----------------------------------------------------------------------------
TODO.local.md
NOTES.local.md
scratch/
tmp/
